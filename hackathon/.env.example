# Environment Variables Template for Responsible Betting Advisor
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# RapidAPI Configuration (for sports data)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=odds.p.rapidapi.com

# Application Configuration
NODE_ENV=development
PORT=3000

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# External APIs
OPENAI_API_KEY=your_openai_api_key  # Optional: for enhanced AI features
ANTHROPIC_API_KEY=your_anthropic_api_key  # Optional: for Claude integration

# Database Configuration (if using external database)
DATABASE_URL=your_database_connection_string

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password